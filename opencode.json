{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "planfix": {
      "type": "local",
      "command": ["uv", "run", "planfix-mcp"],
      "cwd": ".",
      "environment": {
        "PLANFIX_BASE_URL": "{env:PLANFIX_BASE_URL}",
        "PLANFIX_API_TOKEN": "{env:PLANFIX_API_TOKEN}",
        "PLANFIX_TAGS": "{env:PLANFIX_TAGS}"
      }
    }
  }
}